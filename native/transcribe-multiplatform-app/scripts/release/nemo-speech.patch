+// timestamps::diarization_segments for a request of a recording: a turn still active at the end of
+// the frames stays open for the next request, so it comes out once, as from one whole request.
+std::vector<timestamps::Segment>
+session_segments(
+    SpeakerSession& session, const float* activity10, int frames, int speakers,
+    double frame_seconds, double duration) {
+    session.open.resize(static_cast<size_t>(speakers), -1);
+    std::vector<timestamps::Segment> segments;
+    for (int c = 0; c < speakers; ++c) {
+        int64_t begin = session.open[c];
+        for (int t = 0; t < frames; ++t) {
+            const int64_t at = session.frames_out + t;
+            const bool active = activity10[static_cast<size_t>(t) * speakers + c] > 0.5f;
+            if (active && begin < 0)
+                begin = at;
+            if (!active && begin >= 0) {
+                const double start = begin * frame_seconds;
+                const double end = std::min(at * frame_seconds, duration);
+                if (end > start)
+                    segments.push_back({c, start, end});
+                begin = -1;
+            }
+        }
+        if (begin >= 0 && session.final) {
+            const double start = begin * frame_seconds;
+            const double end = std::min((session.frames_out + frames) * frame_seconds, duration);
+            if (end > start)
+                segments.push_back({c, start, end});
+            begin = -1;
+        }
+        session.open[c] = begin;
+    }
+    session.frames_out += frames;
+    std::sort(segments.begin(), segments.end(), [](const auto& a, const auto& b) {
+        return std::tie(a.start, a.end, a.speaker) < std::tie(b.start, b.end, b.speaker);
+    });
+    return segments;
+}
