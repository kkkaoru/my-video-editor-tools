+std::vector<PeeModel::Window>
+PeeModel::plan_session_windows(
+    SpeakerSession& session, int t_mel, int hop, int64_t* frames_left) const {
+    // Frames kept before a window's left context and past its right context: the STFT of a frame
+    // this close to the end of the samples it was computed from would differ from the recording's.
+    constexpr int64_t kEdgeFrames = 8;
+    const int sub = cfg_.asr.subsampling_factor;
+    const int64_t chunk_feat = cfg_.online_inference_length * sub;
+    const int64_t lc = cfg_.chunk_left_context * sub;
+    const int64_t rc = cfg_.chunk_right_context * sub;
+    const int64_t base = session.base_mel;
+    const int64_t total = base + t_mel;  // the recording's frames so far
+    std::vector<Window> plan;
+    for (int64_t ci = session.first_window;; ++ci) {
+        const int64_t stt = ci * chunk_feat;
+        if (stt >= total || (!session.final && stt + chunk_feat + rc + kEdgeFrames > total))
+            break;
+        const int64_t end = std::min(stt + chunk_feat, total);
+        const int64_t enc_stt = std::max(stt - lc, int64_t{0});
+        const int64_t enc_end = std::min(end + rc, total);
+        Window w;
+        w.enc_stt = static_cast<int>(enc_stt - base);
+        w.enc_end = static_cast<int>(enc_end - base);
+        w.left_drop = static_cast<int>((stt - enc_stt) / sub);
+        w.right = static_cast<int>(enc_end - end);
+        int core = static_cast<int>((end + sub - 1) / sub - (stt + sub - 1) / sub);
+        core = std::max(0, std::min(core, out_frames(w.len()) - w.left_drop));
+        w.core = core;
+        plan.push_back(w);
+    }
+    *frames_left = total - session.first_window * chunk_feat;
+    session.first_window += static_cast<int>(plan.size());
+    session.base_mel = std::max(session.first_window * chunk_feat - lc - kEdgeFrames, int64_t{0});
+    session.drop_samples = static_cast<size_t>(session.base_mel - base) * hop;
+    return plan;
+}
