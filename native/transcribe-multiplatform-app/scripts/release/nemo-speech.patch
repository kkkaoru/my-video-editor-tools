diff --git a/src/speechlm/pee/speaker_session.h b/src/speechlm/pee/speaker_session.h
new file mode 100644
index 0000000..4596ba8
--- /dev/null
+++ b/src/speechlm/pee/speaker_session.h
@@ -0,0 +1,30 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+//
+// One recording sent in several speaker-turn requests. Between requests this keeps what a single
+// request keeps in memory (the streaming speaker state), the audio of the windows that could not
+// run yet (they need their right context) and the turns still open at the end, so the columns and
+// the turns are those of the whole recording sent at once.
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+namespace nemo_speech::speechlm {
+
+struct SpeakerSession {
+    // Streaming state: rows of the speaker cache and FIFO, the cache's 80 ms probabilities.
+    std::vector<float> cache, cache_preds, fifo;
+    bool compressed = false;
+    // Samples from raw log-mel frame `base_mel` of the recording on.
+    std::vector<float> carry;
+    int64_t base_mel = 0;
+    size_t drop_samples = 0;  // of carry, once the running request has used them
+    int first_window = 0;     // of the recording: the next to run
+    int64_t frames_out = 0;   // 10 ms frames of the recording already turned into turns
+    std::vector<int64_t> open;  // per column, the frame its unfinished turn began at, or -1
+    double seconds = 0;         // of the recording so far
+    bool final = false;         // the running request is the recording's last
+};
+
+}  // namespace nemo_speech::speechlm
