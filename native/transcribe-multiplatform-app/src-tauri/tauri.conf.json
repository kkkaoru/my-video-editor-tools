{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Transcribe Captions",
  "version": "0.1.3",
  "identifier": "net.teadea.transcribe",
  "build": { "frontendDist": "../dist", "beforeBuildCommand": "bun run build" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Transcribe Captions", "width": 1100, "height": 760, "minWidth": 860, "minHeight": 600, "dragDropEnabled": true }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "resources/": "resources/", "runtime/": "runtime/" },
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "13.0" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" }, "nsis": { "installMode": "currentUser", "languages": ["Japanese", "English"] } }
  }
}
