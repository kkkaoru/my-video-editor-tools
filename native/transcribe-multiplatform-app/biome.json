{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "files": { "includes": ["src/**", "tests/**", "*.ts", "*.json", "!src-tauri", "!dist", "!coverage"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": {
    "rules": {
      "recommended": true,
      "a11y": { "recommended": true },
      "style": {
        "noNestedTernary": "error",
        "useBlockStatements": "error",
        "noNonNullAssertion": "error"
      },
      "suspicious": { "noExplicitAny": "error" },
      "complexity": { "noExcessiveCognitiveComplexity": "error" }
    }
  },
  "css": { "parser": { "tailwindDirectives": true } }
}
